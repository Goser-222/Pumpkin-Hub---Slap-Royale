		local leftOffset =
			-doorPart.CFrame.RightVector * 20

		local targetPosition =
			doorPart.Position + leftOffset

		-- Preserve player's current rotation
		local currentRotation =
			rootPart.CFrame - rootPart.CFrame.Position

		-- Teleport BEFORE entering the code
		rootPart.CFrame =
			CFrame.new(targetPosition) * currentRotation

