--==================================================
-- COUNTDOWN
--==================================================

local function GetCountdownObject()
	local countdown = lp.PlayerGui:FindFirstChild("Countdown")
	local container = countdown and countdown:FindFirstChild("Countdown")

	return container and container:FindFirstChild("TimeLeft")
end

local function GetCountdown()
	local obj = GetCountdownObject()

	if not obj then
		return nil
	end

	return tonumber(obj.Text)
end

local function CountdownAllowed()
	local value = GetCountdown()

	return value ~= nil
		and value >= 1
		and value <= 3
end

--==================================================
-- BODY PARTS
--==================================================

local function GetRightLeg(c)
	if not c then
		return nil
	end

	return c:FindFirstChild("RightUpperLeg")
		or c:FindFirstChild("RightLowerLeg")
		or c:FindFirstChild("RightFoot")
		or c:FindFirstChild("Right Leg")
end

local function GetTorso(c)
	c = c or lp.Character

	if not c then
		return nil
	end

	return c:FindFirstChild("UpperTorso")
		or c:FindFirstChild("Torso")
end

--==================================================
-- FIND ALLOWED TOOL
--==================================================

local function FindAllowedTool(maxDistance)
	local currentChar = lp.Character
	local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return nil
	end

	local closest = nil
	local closestDistance = maxDistance or math.huge

	for _, tool in ipairs(Items:GetChildren()) do

		if tool:IsA("Tool")
			and AllowedTools[tool.Name] then

			local handle = tool:FindFirstChild("Handle")

			if handle then

				local distance =
					(handle.Position - hrp.Position).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closest = tool
				end
			end
		end
	end

	return closest
end

--==================================================
-- PICKUP
--==================================================

local function Pickup(handle)

	if not GetItemsEnabled then
		return false
	end

	if blocked or recoveryRunning then
		return false
	end

	if not CountdownAllowed() then
		return false
	end

	if not handle or not handle.Parent then
		return false
	end

	local id = handle:GetAttribute("ItemId")

	if not id then
		return false
	end

	ItemRemote:FireServer(id)

	local gui = handle:FindFirstChild("ItemGui")

	if gui then
		gui.Enabled = false
	end

	return true
end

--==================================================
-- TELEPORT TO TOOL WITHOUT PICKUP
--==================================================

local function TPToToolWithoutPickup(tool)

	if not tool or not tool.Parent then
		return false
	end

	local currentChar = lp.Character

	local hrp =
		currentChar
		and currentChar:FindFirstChild("HumanoidRootPart")

	local handle = tool:FindFirstChild("Handle")

	if not hrp or not handle then
		return false
	end

	local toolPos = handle.Position

	local sideDirs = {
		Vector3.new(3, 0, 0),
		Vector3.new(-3, 0, 0),
		Vector3.new(0, 0, 3),
		Vector3.new(0, 0, -3)
	}

	local chosenSide = nil

	for _, dir in ipairs(sideDirs) do

		local ray = workspace:Raycast(
			toolPos,
			dir,
			RayParams
		)

		if not ray then
			chosenSide = dir
			break
		end
	end

	if chosenSide then

		hrp.CFrame = CFrame.new(
			toolPos + chosenSide,
			toolPos
		)

	else

		local rightVector

		if Camera then
			rightVector = Camera.CFrame.RightVector
		else
			rightVector = Vector3.new(1, 0, 0)
		end

		local sidePos =
			toolPos + rightVector * 4

		hrp.CFrame = CFrame.new(
			sidePos,
			toolPos
		)
	end

	return true
end

--==================================================
-- TELEPORT + PICKUP
--==================================================

local function TPWaitLookPickup(tool)

	if not tool or not tool.Parent then
		return false
	end

	if lastPicked == tool then
		return false
	end

	if not GetItemsEnabled then
		return false
	end

	if blocked or recoveryRunning then
		return false
	end

	if not CountdownAllowed() then
		return false
	end

	local currentChar = lp.Character

	local hrp =
		currentChar
		and currentChar:FindFirstChild("HumanoidRootPart")

	local handle = tool:FindFirstChild("Handle")

	if not hrp or not handle then
		return false
	end

	lastPicked = tool

	local toolPos = handle.Position

	local sideDirs = {
		Vector3.new(2, 0, 0),
		Vector3.new(-2, 0, 0),
		Vector3.new(0, 0, 2),
		Vector3.new(0, 0, -2)
	}

	local chosenSide = nil

	for _, dir in ipairs(sideDirs) do

		local ray = workspace:Raycast(
			toolPos,
			dir,
			RayParams
		)

		if not ray then
			chosenSide = dir
			break
		end
	end

	if chosenSide then

		hrp.CFrame = CFrame.new(
			toolPos + chosenSide,
			toolPos
		)

	else

		local rightVector

		if Camera then
			rightVector = Camera.CFrame.RightVector
		else
			rightVector = Vector3.new(1, 0, 0)
		end

		local sidePos =
			toolPos + rightVector * 4

		hrp.CFrame = CFrame.new(
			sidePos,
			toolPos
		)
	end

	task.wait(GetItemsMode == "Fast" and 0.4 or 1)

	if not GetItemsEnabled then
		return false
	end

	if blocked or recoveryRunning then
		return false
	end

	if not CountdownAllowed() then
		return false
	end

	if not handle or not handle.Parent then
		return false
	end

	hrp.CFrame = CFrame.new(
		hrp.Position,
		toolPos
	)

	local success = Pickup(handle)

	task.wait(GetItemsMode == "Fast" and 0.2 or 0.5)

	return success
end

--==================================================
-- GET ITEMS IN ORDER
--==================================================

local function GetOrderedItems()

	local bomb = nil

	local strengthList = {}
	local bullList = {}
	local bobaList = {}
	local speedList = {}
	local frogList = {}

	for _, obj in ipairs(Items:GetChildren()) do

		if obj:IsA("Tool") then

			local handle = obj:FindFirstChild("Handle")

			if handle then

				if obj.Name == "Bomb"
					and not BombPickedThisRound
					and not BombTeleportedThisRound
					and not bomb then

					bomb = obj

				elseif obj.Name == "Potion of Strength" then

					table.insert(
						strengthList,
						obj
					)

				elseif obj.Name == "Bull's essence" then

					table.insert(
						bullList,
						obj
					)

				elseif obj.Name == "Boba" then

					table.insert(
						bobaList,
						obj
					)

				elseif obj.Name == "Speed Potion" then

					table.insert(
						speedList,
						obj
					)

				elseif obj.Name == "Frog Potion" then

					table.insert(
						frogList,
						obj
					)
				end
			end
		end
	end

	return {
		{bomb},
		strengthList,
		bullList,
		bobaList,
		speedList,
		frogList
	}
end

--==================================================
-- COLLECT EXACT NUMBER
--==================================================

local function CollectItems(amount)

	if CollectionRunning then
		return 0
	end

	if not GetItemsEnabled then
		return 0
	end

	if blocked or recoveryRunning then
		return 0
	end

	if not CountdownAllowed() then
		return 0
	end

	CollectionRunning = true

	local picked = 0

	local order = GetOrderedItems()

	for _, group in ipairs(order) do

		for _, tool in ipairs(group) do

			if picked >= amount then
				break
			end

			if not GetItemsEnabled then
				break
			end

			if blocked or recoveryRunning then
				break
			end

			if not CountdownAllowed() then
				break
			end

			if tool and tool.Parent then

				-- Bomb may only be teleported to once.
				if tool.Name == "Bomb"
					and BombTeleportedThisRound then

					continue
				end

				local success =
					TPWaitLookPickup(tool)

				if success then

					picked += 1

					if tool.Name == "Bomb" then

						BombPickedThisRound = true
						BombTeleportedThisRound = true
					end
				end
			end
		end

		if picked >= amount then
			break
		end
	end

	CollectionRunning = false

	return picked
end

