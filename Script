local function TPWaitLookPickup(tool)
	local hrp=Char:FindFirstChild("HumanoidRootPart")
	local handle=tool:FindFirstChild("Handle")
	if not hrp or not handle then return end
	if lastPicked==tool then return end
	lastPicked=tool
	local toolPos=handle.Position
	local sideDirs={
		Vector3.new(2,0,0),
		Vector3.new(-2,0,0),
		Vector3.new(0,0,2),
		Vector3.new(0,0,-2)
	}
	local chosenSide=nil
	for _,dir in ipairs(sideDirs) do
		local ray=workspace:Raycast(toolPos,dir,RayParams)
		if not ray then
			chosenSide=dir
			break
		end
	end
	if chosenSide then
		local sidePos=toolPos+chosenSide
		hrp.CFrame=CFrame.new(sidePos,toolPos)
	else
		local fallbackSide=Camera.CFrame.RightVector*4
		local sidePos=toolPos+fallbackSide
		hrp.CFrame=CFrame.new(sidePos,toolPos)
	end
	local antiFall=Instance.new("Part")
	antiFall.Size=Vector3.new(6,1,6)
	antiFall.Anchored=true
	antiFall.CanCollide=true
	antiFall.Transparency=1
	antiFall.Position=hrp.Position-Vector3.new(0,2,0)
	antiFall.Parent=workspace
	task.delay(1,function()
		if antiFall then antiFall:Destroy() end
	end)
	task.wait(0.25)
	hrp.CFrame=CFrame.new(hrp.Position,toolPos)
	local id=handle:GetAttribute("ItemId")
	if id then
		ItemRemote:FireServer(id)
		local gui=handle:FindFirstChild("ItemGui")
		if gui then gui.Enabled=false end
	end
	task.wait(0.25)
end

