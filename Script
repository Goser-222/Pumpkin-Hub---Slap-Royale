	local readOK, encoded = pcall(function()
		if type(isfile) == "function" and not isfile(SavedButtonStatesFile) then
			return nil
		end
		if type(readfile) ~= "function" then
			return nil
		end
		return readfile(SavedButtonStatesFile)
	end)

	if not readOK or not encoded or encoded == "" then
		return
	end

	local decodeOK, snapshot = pcall(function()
		return HttpService:JSONDecode(encoded)
	end)

	if not decodeOK or type(snapshot) ~= "table" then
		return
	end

	RestoringSavedButtons = true

	for name, value in pairs(snapshot) do
		local button = SavedToggleButtons[name]
		if button and type(value) == "boolean" then
			pcall(function()
				button:Set(value)
			end)
			SavedButtonStates[name] = value
		end
	end

	RestoringSavedButtons = false

	Rayfield:Notify({
		Title = "Saved Button States",
		Content = "Restored saved toggles and enabled their features.",
		Duration = 5
	})
end)
