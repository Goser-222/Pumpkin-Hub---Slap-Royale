local function InstantLand()
	if teleportCount >= 1 then return end

	local c = Player.Character
	if not c then return end

	local hrp = c:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local crystal = workspace:FindFirstChild("CrystalBlue", true)
	if not crystal then return end

	local target = Ground(crystal.Position)
	hrp.CFrame = CFrame.new(target, hrp.Position + hrp.CFrame.LookVector)

	teleportCount += 1
	ILEnabled = false
	CanCount = false
end

