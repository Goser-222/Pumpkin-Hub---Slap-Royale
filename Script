--------------------------------------------------

local function FindPlayer(name)
	if not name then
		return nil
	end

	return Players:FindFirstChild(name)
end

--------------------------------------------------
-- DISCONNECT TARGET CONNECTIONS
--------------------------------------------------

local function DisconnectTargetConnections()

	if TargetCharacterConnection then
		TargetCharacterConnection:Disconnect()
		TargetCharacterConnection = nil
	end

	if TargetDeathConnection then
		TargetDeathConnection:Disconnect()
		TargetDeathConnection = nil
	end
end

--------------------------------------------------
-- TARGET DEATH
--------------------------------------------------

local function SetupTargetDeathDetection()

	DisconnectTargetConnections()

	if not TargetPlayer then
		return
	end

	--------------------------------------------------
	-- SETUP HUMANOID DEATH DETECTION
	--------------------------------------------------

	local function SetupCharacter(character)

		if not character then
			return
		end

		if TargetDeathConnection then
			TargetDeathConnection:Disconnect()
			TargetDeathConnection = nil
		end

		local humanoid =
			character:WaitForChild(
				"Humanoid",
				5
			)

		if not humanoid then
			return
		end

		TargetDeathConnection =
			humanoid.Died:Connect(function()

				-- Disable teleport
				TeleportToTargetEnabled = false

				-- Reset counter
				RagdollWaitCount = 0

				Rayfield:Notify({
					Title = "Teleport To Target",
					Content = TargetPlayer.Name
						.. " died. Teleport disabled.",
					Duration = 3
				})
			end)
	end

	--------------------------------------------------
	-- CURRENT CHARACTER
	--------------------------------------------------

	if TargetPlayer.Character then
		task.spawn(function()
			SetupCharacter(TargetPlayer.Character)
		end)
	end

	--------------------------------------------------
	-- FUTURE RESPAWN
	--------------------------------------------------

	TargetCharacterConnection =
		TargetPlayer.CharacterAdded:Connect(function(character)

			-- Wait for new humanoid
			task.spawn(function()
				SetupCharacter(character)
			end)

		end)
end

