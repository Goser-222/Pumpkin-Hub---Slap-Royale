			["9648734698"] = "2",
			["9648712563"] = "2",
			["9648742013"] = "7",
			["9648745618"] = "3",
			["9648715920"] = "6",
			["9648752438"] = "2",
			["9648749145"] = "8",
			["9648759883"] = "9",
			["9648738553"] = "8"
		}

		local surfaceGui = workspace.Map.CodeBrick.SurfaceGui

		-- Find the actual IMGTemplate objects
		local templates = {}

		for _, obj in ipairs(surfaceGui:GetChildren()) do
			if obj.Name == "IMGTemplate" then
				table.insert(templates, obj)
			end
		end

		if #templates ~= 4 then
			Rayfield:Notify({
				Title = "Get Lab Code",
				Content = "Found " .. #templates .. " images instead of 4.",
				Duration = 5
			})
			return
		end

		-- Use the GUI's actual position.
		-- X is primary, Y is secondary.
		table.sort(templates, function(a, b)
			local ax = a.AbsolutePosition.X
			local bx = b.AbsolutePosition.X

			if math.abs(ax - bx) > 1 then
				return ax < bx
			end

			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end)

		local result = {}

		for i, imageObject in ipairs(templates) do

			local image = tostring(imageObject.Image)

			-- Extract the numeric Roblox asset ID.
			local assetId =
				image:match("[?&]id=(%d+)")
				or image:match("rbxassetid://(%d+)")
				or image:match("(%d+)$")

			local digit = assetId and codes[assetId]

			if not digit then
				Rayfield:Notify({
					Title = "Get Lab Code",
					Content = "Unknown image at position " .. i
						.. ": " .. image,
					Duration = 5
				})
				return
			end

			result[i] = digit
		end

		local CodeEsp = table.concat(result)

		Rayfield:Notify({
			Title = "You have code [ " .. CodeEsp .. " ]",
			Content = "",
			Duration = 5
		})
	end
})

