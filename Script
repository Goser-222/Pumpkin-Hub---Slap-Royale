local function GetPermanentItemsCountdown()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    local countdownGui = playerGui:FindFirstChild("Countdown")
    if not countdownGui then return nil end

    local countdownFrame = countdownGui:FindFirstChild("Countdown")
    if not countdownFrame then return nil end

    local timeLeft = countdownFrame:FindFirstChild("TimeLeft")
    if not timeLeft then return nil end

    local number = string.match(timeLeft.Text, "%d+%.?%d*")
    return number and tonumber(number) or nil
end

task.spawn(function()
    local itemsAllowed = false
    local reachedOne = false
    local notified = false

    while true do
        local success, countdown = pcall(GetPermanentItemsCountdown)

        if not success or countdown == nil then
            itemsAllowed = false
            reachedOne = false
            notified = false

        elseif countdown > 1 then
            itemsAllowed = false
            reachedOne = false
            notified = false

        elseif not reachedOne then
            reachedOne = true
            itemsAllowed = false

            task.wait(1)

            local checkOK, current = pcall(GetPermanentItemsCountdown)

            if checkOK and current ~= nil and current <= 1 then
                itemsAllowed = true
            else
                reachedOne = false
            end
        end

        -- Only use items when the Use Items toggle is enabled.
        if AutoUseEnabled and itemsAllowed then
            local character = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local usedCount = 0

            if character and backpack then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if not AutoUseEnabled or not itemsAllowed then
                        break
                    end

                    if AutoUseList and AutoUseList[tool.Name] then
                        local equipped = pcall(function()
                            tool.Parent = character
                        end)

                        if equipped then
                            task.wait(0.5)

                            if AutoUseEnabled and itemsAllowed then
                                local activated = pcall(function()
                                    tool:Activate()
                                end)

                                if activated then
                                    usedCount = usedCount + 1
                                end
                            end
                        end
                    end
                end
            end

            if usedCount > 0 and not notified then
                notified = true

                Rayfield:Notify({
                    Title = "Use Permanent Items",
                    Content = "Used " .. usedCount .. " item(s)",
                    Duration = 5
                })
            end
        end

        task.wait(0.2)
    end
end)

