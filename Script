			-- SAVE ORIGINAL POSITION
			--------------------------------------------------

			local originalCFrame =
				localRoot.CFrame

			--------------------------------------------------
			-- TELEPORT TO TARGET
			--------------------------------------------------

			localRoot.CFrame =
				targetRoot.CFrame

			--------------------------------------------------
			-- WAIT 0.5 SECONDS
			--------------------------------------------------

			task.wait(0.5)

			--------------------------------------------------
			-- TELEPORT BACK
			--------------------------------------------------

			if TeleportToTargetEnabled then

				local currentRoot =
					GetLocalRoot()

				if currentRoot then

					currentRoot.CFrame =
						originalCFrame
				end
			end

			--------------------------------------------------
			-- WAIT 0.5 SECONDS
			--------------------------------------------------

			task.wait(0.5)
		end

		TeleportLoopRunning = false
	end)
