	CurrentValue = false,
	Callback = function(Value)

		local Players = game:GetService("Players")
		local LocalPlayer = Players.LocalPlayer

		-- 2 second cooldown
		if _G.GoUnderMapCooldown then
			Rayfield:Notify({
				Title = "Go Under Map",
				Content = "Teleport is on cooldown.",
				Duration = 2
			})
			return
		end

		local character = LocalPlayer.Character
			or LocalPlayer.CharacterAdded:Wait()

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if not rootPart or not humanoid then
			Rayfield:Notify({
				Title = "Go Under Map",
				Content = "Character not ready.",
				Duration = 5
			})
			return
		end

		_G.GoUnderMapCooldown = true

		if Value then
			-- ==========================================
			-- ON: TELEPORT 30 STUDS DOWN
			-- ==========================================

			rootPart.CFrame =
				rootPart.CFrame + Vector3.new(0, -30, 0)

			Rayfield:Notify({
				Title = "Go Under Map",
				Content = "Teleported 30 studs down.",
				Duration = 3
			})

		else
			-- ==========================================
			-- OFF: FIND TOP OF TERRAIN
			-- ==========================================

			local terrain = workspace:FindFirstChildOfClass("Terrain")

			if not terrain then
				_G.GoUnderMapCooldown = false

				Rayfield:Notify({
					Title = "Go Under Map",
					Content = "Terrain not found.",
					Duration = 5
				})
				return
			end

			-- Start high above the player and raycast DOWN.
			-- This finds the TOP surface of the terrain.
			local rayOrigin =
				rootPart.Position + Vector3.new(0, 1000, 0)

			local rayDirection =
				Vector3.new(0, -2000, 0)

			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Include
			rayParams.FilterDescendantsInstances = {
				terrain
			}
			rayParams.IgnoreWater = true

			local rayResult = workspace:Raycast(
				rayOrigin,
				rayDirection,
				rayParams
			)

			if not rayResult then
				_G.GoUnderMapCooldown = false

				Rayfield:Notify({
					Title = "Go Under Map",
					Content = "Could not find the top of the terrain.",
					Duration = 5
				})
				return
			end

			-- Character height
			local halfHeight = rootPart.Size.Y / 2

			-- Put the HumanoidRootPart above the terrain.
			local targetPosition =
				rayResult.Position
				+ Vector3.new(0, halfHeight + 2, 0)

			-- Preserve rotation
			local currentRotation =
				rootPart.CFrame - rootPart.CFrame.Position

			rootPart.CFrame =
				CFrame.new(targetPosition) * currentRotation

			Rayfield:Notify({
				Title = "Go Under Map",
				Content = "Teleported on top of the terrain.",
				Duration = 3
			})
		end

		-- ==========================================
		-- 2 SECOND COOLDOWN
		-- ==========================================

		task.delay(2, function()
			_G.GoUnderMapCooldown = false
		end)
	end
})

