--------------------------------------------------
-- RAGDOLL CHECK
--------------------------------------------------

local function IsTargetRagdolled()

	if not TargetPlayer then
		return false
	end

	local character =
		TargetPlayer.Character

	if not character then
		return false
	end

	--------------------------------------------------
	-- ATTRIBUTE CHECK
	--------------------------------------------------

	local ragdolledAttribute =
		character:GetAttribute("Ragdolled")

	if ragdolledAttribute == true then
		return true
	end

	--------------------------------------------------
	-- BOOLVALUE CHECK
	--------------------------------------------------

	local ragdolledValue =
		character:FindFirstChild(
			"Ragdolled",
			true
		)

	if ragdolledValue
		and ragdolledValue:IsA("BoolValue") then

		if ragdolledValue.Value then
			return true
		end
	end

	--------------------------------------------------
	-- HUMANOID STATE CHECK
	--------------------------------------------------

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then

		local state =
			humanoid:GetState()

		if state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.Physics then

			return true
		end
	end

	return false
end

--------------------------------------------------
-- CHECK TARGET DEAD
--------------------------------------------------

local function IsTargetDead()

	if not TargetPlayer then
		return true
	end

	local character =
		TargetPlayer.Character

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return false
	end

	return humanoid.Health <= 0
end

--------------------------------------------------
-- WAIT UNTIL UNRAGDOLLED
--------------------------------------------------

local function WaitUntilUnragdolled()

	while TeleportToTargetEnabled do

		--------------------------------------------------
		-- TARGET EXISTS?
		--------------------------------------------------

		if not TargetPlayer
			or not TargetPlayer.Parent then

			return false
		end

		--------------------------------------------------
		-- TARGET DEAD?
		--------------------------------------------------

		if IsTargetDead() then

			TeleportToTargetEnabled = false
			RagdollWaitCount = 0

			return false
		end

		--------------------------------------------------
		-- TARGET ROOT
		--------------------------------------------------

		local targetRoot =
			GetTargetRoot()

		if not targetRoot then

			task.wait(0.1)

			continue
		end

		--------------------------------------------------
		-- TARGET NOT RAGDOLLED
		--------------------------------------------------

		if not IsTargetRagdolled() then
			return true
		end

		--------------------------------------------------
		-- COUNT ONE RAGDOLL WAIT
		--------------------------------------------------

		RagdollWaitCount += 1

		--------------------------------------------------
		-- 5 RAGDOLL WAITS
		--------------------------------------------------

		if RagdollWaitCount >= MaxRagdollWaits then

			Rayfield:Notify({
				Title = "Kill Player",
				Content = "Ragdoll limit reached. Waiting 15 seconds.",
				Duration = 3
			})

			--------------------------------------------------
			-- WAIT 10 SECONDS
			--------------------------------------------------

			task.wait(RagdollCooldown)

			--------------------------------------------------
			-- RESET COUNTER
			--------------------------------------------------

			RagdollWaitCount = 0

			if not TeleportToTargetEnabled then
				return false
			end

		else

			--------------------------------------------------
			-- KEEP CHECKING EVERY 0.1 SECONDS
			-- WITHOUT COUNTING AGAIN
			--------------------------------------------------

			repeat

				task.wait(0.1)

				if not TeleportToTargetEnabled then
					return false
				end

				if not TargetPlayer
					or not TargetPlayer.Parent then

					return false
				end

				if IsTargetDead() then

					TeleportToTargetEnabled = false
					RagdollWaitCount = 0

					return false
				end

			until not IsTargetRagdolled()
		end
	end

	return false
end

--------------------------------------------------
-- TELEPORT LOOP
--------------------------------------------------

local function StartTeleportLoop()

	if TeleportLoopRunning then
		return
	end

	TeleportLoopRunning = true

	task.spawn(function()

		while TeleportToTargetEnabled do

			--------------------------------------------------
			-- TARGET STILL EXISTS?
			--------------------------------------------------

			if not TargetPlayer
				or not TargetPlayer.Parent then

				TeleportToTargetEnabled = false
				break
			end

			--------------------------------------------------
			-- TARGET DEAD?
			--------------------------------------------------

			if IsTargetDead() then

				TeleportToTargetEnabled = false
				RagdollWaitCount = 0

				break
			end

			--------------------------------------------------
			-- WAIT FOR UNRAGDOLL
			--------------------------------------------------

			local ready =
				WaitUntilUnragdolled()

			if not ready then
				break
			end

			if not TeleportToTargetEnabled then
				break
			end

			--------------------------------------------------
			-- GET ROOTS
			--------------------------------------------------

			local localRoot =
				GetLocalRoot()

			local targetRoot =
				GetTargetRoot()

			if not localRoot
				or not targetRoot then

				task.wait(0.1)

				continue
			end

			--------------------------------------------------
			-- FINAL DEAD CHECK
			--------------------------------------------------

			if IsTargetDead() then

				TeleportToTargetEnabled = false
				RagdollWaitCount = 0

				break
			end

			--------------------------------------------------
			-- FINAL RAGDOLL CHECK
			--------------------------------------------------

			if IsTargetRagdolled() then

				task.wait(0.1)

				continue
			end

