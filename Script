--==================================================

local function TweenToGetAllTool(tool)

	if not tool or not tool.Parent then
		return false
	end

	local currentChar = lp.Character

	local hrp =
		currentChar
		and currentChar:FindFirstChild("HumanoidRootPart")

	local handle =
		tool:FindFirstChild("Handle")

	if not hrp or not handle then
		return false
	end

	local targetPosition =
		handle.Position + Vector3.new(2, 0, 0)

	local targetCFrame =
		CFrame.new(
			targetPosition,
			handle.Position
		)

	local tweenInfo =
		TweenInfo.new(
			0.1,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		)

	local tween =
		TweenService:Create(
			hrp,
			tweenInfo,
			{
				CFrame = targetCFrame
			}
		)

	local finished = false

	local connection =
		tween.Completed:Connect(function()
			finished = true
		end)

	tween:Play()

	while not finished do

		if not GetAllItemsEnabled then

			tween:Cancel()

			if connection then
				connection:Disconnect()
			end

			return false
		end

		if not tool.Parent then

			tween:Cancel()

			if connection then
				connection:Disconnect()
			end

			return false
		end

		task.wait()
	end

	if connection then
		connection:Disconnect()
	end

	return true
end

--==================================================
-- PICK UP TOOL
--==================================================

local function GetAllPickup(tool)

	if not GetAllItemsEnabled then
		return false
	end

	if not tool or not tool.Parent then
		return false
	end

	local handle =
		tool:FindFirstChild("Handle")

	if not handle then
		return false
	end

	local id =
		handle:GetAttribute("ItemId")

	if not id then
		return false
	end

	ItemRemote:FireServer(id)

	local gui =
		handle:FindFirstChild("ItemGui")

	if gui then
		gui.Enabled = false
	end

	return true
end

--==================================================
-- GET ALL ITEMS LOOP
--==================================================

local function StartGetAllItems()

	if GetAllItemsRunning then
		return
	end

	GetAllItemsRunning = true

	while GetAllItemsEnabled do

		-- Use the same countdown requirement.
		if CountdownAllowed() then

			-- Always get the closest remaining Tool.
			local tool =
				FindClosestGetAllTool()

			if tool then

				-- Tween to tool for 0.4 seconds.
				local arrived =
					TweenToGetAllTool(tool)

				if arrived
					and GetAllItemsEnabled
					and tool.Parent then

					-- Wait 0.4 seconds after arriving.
					task.wait(0.4)

					if GetAllItemsEnabled
						and tool.Parent then

						-- Pick it up.
						GetAllPickup(tool)

						-- Wait 2 seconds before
						-- going to the next tool.
						task.wait(2)
					end

				else
					task.wait(0.1)
				end

			else

				-- No tools currently available.
				task.wait(0.1)

			end

		else

			-- Wait for the countdown.
			task.wait(0.1)

		end
	end

	GetAllItemsRunning = false
end

--==================================================
-- TOGGLE
--==================================================

ItemsTab:CreateToggle({
	Name = "Get all items",
	CurrentValue = false,

	Callback = function(v)

		GetAllItemsEnabled = v

		if v then

			SetGetAllItemsNoclip(true)

			if not GetAllItemsRunning then
				task.spawn(StartGetAllItems)
			end

		else

			GetAllItemsEnabled = false

			SetGetAllItemsNoclip(false)
		end
	end
})

