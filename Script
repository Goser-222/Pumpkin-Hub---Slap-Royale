		-- ENTER CODE
		-- ==========================================

		for i = 1, #CodeEsp do

			local digit = CodeEsp:sub(i, i)
			local button = buttonsFolder:FindFirstChild(digit)

			if not button then
				Rayfield:Notify({
					Title = "Open Lab + Teleport",
					Content = "Button " .. digit .. " not found.",
					Duration = 5
				})
				return
			end

			local clickDetector =
				button:FindFirstChildOfClass("ClickDetector")

			if not clickDetector then
				Rayfield:Notify({
					Title = "Open Lab + Teleport",
					Content = "ClickDetector missing from button "
						.. digit .. ".",
					Duration = 5
				})
				return
			end

			fireclickdetector(clickDetector)

			task.wait(0.15)
		end

		-- ==========================================
		-- PRESS ENTER
		-- ==========================================

		local enterButton =
			buttonsFolder:FindFirstChild("Enter")

		if not enterButton then
			Rayfield:Notify({
				Title = "Open Lab + Teleport",
