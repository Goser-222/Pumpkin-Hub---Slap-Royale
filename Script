local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local AutoGotoCrate = false
local Running = false

local Height = 10

local function GetRoot()
	local character = LocalPlayer.Character
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function IsCrate(crate)
	return crate
		and crate.Parent
		and crate:IsA("Model")
		and crate.Name == "Crate"
end

local function GetCratePosition(crate)
	if not IsCrate(crate) then
		return nil
	end

	if crate.PrimaryPart then
		return crate.PrimaryPart.Position
	end

	local success, pivot = pcall(function()
		return crate:GetPivot()
	end)

	if success then
		return pivot.Position
	end

	return nil
end

local function GetClosestCrate(cratesFolder)
	local root = GetRoot()

	if not root then
		return nil
	end

	local closest = nil
	local closestDistance = math.huge

	for _, crate in ipairs(cratesFolder:GetChildren()) do
		if IsCrate(crate) then
			local position = GetCratePosition(crate)

			if position then
				local distance =
					(root.Position - position).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closest = crate
				end
			end
		end
	end

	return closest
end

local function StartAutoGoto(cratesFolder)
	if Running then
		return
	end

	Running = true

	task.spawn(function()

		while AutoGotoCrate
			and cratesFolder
			and cratesFolder.Parent do

			local crate = GetClosestCrate(cratesFolder)

			if crate then
				local root = GetRoot()
				local position = GetCratePosition(crate)

				if root and position then
					-- Teleport directly above the crate.
					root.CFrame =
						CFrame.new(
							position + Vector3.new(0, Height, 0)
						)
				end
			end

			task.wait(0.1)
		end

		Running = false
	end)
end

