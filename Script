--==================================================
-- SAVE BUTTON STATES AND RESTORE FEATURES
-- Turning "Save Script Settings" ON takes one snapshot.
-- On the next script launch, saved ON toggles also run
-- their feature callbacks and enable those features.
--==================================================

local HttpService = game:GetService("HttpService")
local SavedButtonStatesFile = "PumpkinHub_ButtonStates.json"
local SavedButtonStates = {}
local SavedToggleButtons = {}
local RestoringSavedButtons = false

local function CreateSavedToggle(tab, config)
	local toggleName = config.Name
	local originalCallback = config.Callback
	SavedButtonStates[toggleName] = config.CurrentValue == true

	config.Callback = function(value)
		-- Do not change the saved snapshot during restoration,
		-- but always run the callback so saved ON features enable.
		if not RestoringSavedButtons then
			SavedButtonStates[toggleName] = value == true
		end

		if originalCallback then
			originalCallback(value)
		end
	end

	local button = tab:CreateToggle(config)
	SavedToggleButtons[toggleName] = button
	return button
end

local function SaveButtonSnapshot()
	local snapshot = {}

	for name, value in pairs(SavedButtonStates) do
		snapshot[name] = value == true
	end

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(snapshot)
	end)

	if not ok then
		Rayfield:Notify({
			Title = "Save Script Settings",
			Content = "Could not encode button settings.",
			Duration = 4
		})
		return
	end

	local writeOK = pcall(function()
		if type(writefile) ~= "function" then
			error("writefile is not available")
		end
		writefile(SavedButtonStatesFile, encoded)
	end)

	Rayfield:Notify({
		Title = "Save Script Settings",
		Content = writeOK and "Saved the current button states." or
			"Saving requires executor file-write support.",
		Duration = 5
	})
end

