					local frogList = {}

					for _,obj in ipairs(workspace:GetDescendants()) do
						if obj:IsA("Tool") then
							local handle = obj:FindFirstChild("Handle")
							if handle then
								if obj.Name == "Bomb" and not BombPickedThisRound and not bomb then
									bomb = obj
								elseif obj.Name == "Potion of Strength" then
									table.insert(strengthList, obj)
								elseif obj.Name == "Bull's essence" then
									table.insert(bullList, obj)
								elseif obj.Name == "Boba" then
									table.insert(bobaList, obj)
								elseif obj.Name == "Speed Potion" then
									table.insert(speedList, obj)
								elseif obj.Name == "Frog Potion" then
									table.insert(frogList, obj)
								end
							end
						end
					end

					local order = {
						{bomb},
						strengthList,
						bullList,
						bobaList,
						speedList,
						frogList
					}

					local picked = 0

					for _,group in ipairs(order) do
						for _,tool in ipairs(group) do
							if tool then
								TPWaitLookPickup(tool)
								picked = picked + 1
								if tool.Name == "Bomb" then
									BombPickedThisRound = true
								end
								if picked >= 4 then
									task.wait(0)
									break
								end
							end
						end
						if picked >= 4 then
							break
						end
					end

					task.wait(5)
				end
			end
		end

		task.wait(0.2)
	end
end)

local lastSlap = 0

local function NotRagdolled(char)
	local hum = char:FindFirstChild("Humanoid")
	if not hum then return false end
	if hum.Health <= 0 then return false end
	if hum.PlatformStand == true then return false end
	return true
end

task.spawn(function()
	while true do
		if _G.SlapAura then
			local now = tick()
			if now - lastSlap >= 0.1 then
				local hrp = Char:FindFirstChild("HumanoidRootPart")
				local toolEquipped = Char:FindFirstChildWhichIsA("Tool")

				if hrp and toolEquipped then
					for _,player in ipairs(Players:GetPlayers()) do
						if player ~= lp then
							local c = player.Character
							local chrp = c and c:FindFirstChild("HumanoidRootPart")

							if chrp and NotRagdolled(c) then
								local dist = (hrp.Position - chrp.Position).Magnitude
								if dist <= 20 then
									lastSlap = now
									pcall(function()
										ReplicatedStorage.Remotes.Slap:FireServer(chrp)
									end)
									break
								end
							end
						end
					end
				end
			end
		end
		task.wait(0.005)
	end
end)

